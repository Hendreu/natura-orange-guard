# Exemplo de .env para deploy com Docker
#
# O projeto carrega este arquivo em runtime via docker-compose.yml.
# Ajuste DATABASE_URL para apontar para o seu PostgreSQL.

# Exemplo com PostgreSQL externo (produção/on-prem):
DATABASE_URL=postgres://usuario:senha@host:5432/qualys_db

# Exemplo com PostgreSQL interno do Compose (usar com docker-compose.postgres.yml):
# POSTGRES_DB=qualys_db
# POSTGRES_USER=qualys_vis
# POSTGRES_PASSWORD=senha_forte_aqui
# DATABASE_URL=postgres://qualys_vis:senha_forte_aqui@postgres:5432/qualys_db

# Runtime
PORT=3000
HOST=0.0.0.0
